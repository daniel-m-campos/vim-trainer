      "def check_headers(line):",
      "    pattern = '# (.*)'",
      "    for index in range(6):",
      "        if re.match(pattern, line):",
      "            return wrap(line[(index + 2):], 'h' + str(index + 1))",
      "        pattern = '#' + pattern",
      "    return line",
      "",
      "",
