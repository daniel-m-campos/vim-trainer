      "def territory(self, x, y):",
      "    if not self.valid(x, y):",
      "        raise ValueError('Invalid coordinate')",
      "    if self.board[y][x] in STONES:",
      "        return (NONE, set())",
      "",
      "    visited_territory, visited_stones = self.walk(x, y)",
      "    result = set(visited_territory)",
