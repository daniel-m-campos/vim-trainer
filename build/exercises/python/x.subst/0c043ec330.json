      "        return (visited_stones[0], result)",
      "    return (NONE, result)",
      "",
      "def territories(self):",
      "    owners = STONES + [NONE]",
      "    result = {owner:set() for owner in owners}",
      "    visited = set()",
      "    for row in range(self.height):",
      "        for column in range(self.width):",
      "            if not (column, row) in visited:",
