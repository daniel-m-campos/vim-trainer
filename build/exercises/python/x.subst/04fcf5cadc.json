      "def BuildTree(records):",
      "    parent_dict = {}",
      "    node_dict = {}",
      "    ordered_id = sorted(idx.record_id for idx in records)",
      "",
      "    for target in records:",
      "        validate_record(target)",
      "        parent_dict[target.record_id] = target.parent_id",
      "        node_dict[target.record_id] = Node(target.record_id)",
      "",
      "    root_id = 0",
      "    root = None",
      "",
      "    for index, record_id in enumerate(ordered_id):",
      "        if index != record_id:",
      "            raise ValueError('Record id is invalid or out of order.')",
