      "            if index1 < col_len - 1:",
      "                counts += minefield[index1 + 1][low:high].count('*')",
      "            if counts == 0:",
      "                continue",
      "",
      "            board[index1][index2] = str(counts)",
      "    return [''.join(row) for row in board]"
