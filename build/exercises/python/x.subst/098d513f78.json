      "EIGHT_BIT_MASK = 0x80",
      "SEVEN_BIT_MASK = 0x7f",
      "",
      "",
      "def encode_single(number):",
      "    byte_string = [number & SEVEN_BIT_MASK]",
      "    number >>= 7",
      "",
      "    while number > 0:",
      "        byte_string.append(number & SEVEN_BIT_MASK | EIGHT_BIT_MASK)",
      "        number >>= 7",
      "",
      "    return byte_string[::-1]",
      "",
      "",
      "def encode(numbers):",
      "    return sum((encode_single(number) for number in numbers), [])"
