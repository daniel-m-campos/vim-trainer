      "            self._inorder_traverse(node.left, elements)",
      "            elements.append(node.data)",
      "            self._inorder_traverse(node.right, elements)",
      "",
      "    def data(self):",
      "        return self.root",
      "",
      "    def sorted_data(self):",
      "        elements = []",
      "        self._inorder_traverse(self.root, elements)",
      "        return elements"
