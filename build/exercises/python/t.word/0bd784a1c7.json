    "lines": [
      "def can_chain(dominoes):",
      "    if not any(dominoes):",
      "        return []",
      "    for perm in permutations(dominoes):",
      "        chain = reduce(build_chain, perm[1:], [perm[0]])",
      "        if chain is not None and chain[0][0] == chain[-1][1]:",
      "            return chain",
      "    return None"
