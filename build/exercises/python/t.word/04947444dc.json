      "    \"\"\"Generates all palindromes with `nd` number of digits that are\"\"\"",
      "    even_nd = (digit_count % 2 == 0)",
      "",
      "    min_left_half = max(10 ** (int(ceil(digit_count / 2)) - 1),",
      "                        minimum // (10 ** (digit_count // 2)))",
      "    max_left_half = min((10 ** int(ceil(digit_count / 2))) - 1,",
