      "",
      "    def __init__(self, diagram, students=None):",
      "        students = sorted(students or self.STUDENTS)",
      "        front, back = diagram.splitlines()",
      "        self.cups = {}",
      "        for idx, student in enumerate(students[: len(front)]):",
