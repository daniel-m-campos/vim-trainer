      "            return 'Whoa, chill out!'",
      "    elif _is_question(hey_bob):",
      "        return 'Sure.'",
      "    else:",
      "        return 'Whatever.'",
      "",
      "",
      "def _is_silence(hey_bob):",
      "    return hey_bob == ''",
      "",
      "",
      "def _is_shouting(hey_bob):",
      "    return hey_bob.isupper()",
      "",
      "",
      "def _is_question(hey_bob):",
      "    return hey_bob.endswith('?')"
