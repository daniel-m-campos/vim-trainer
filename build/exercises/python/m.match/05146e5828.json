      "def check_italic(line):",
      "    italic_pattern = '(.*)_(.*)_(.*)'",
      "    italic_match = re.match(italic_pattern, line)",
      "    if italic_match:",
      "        return italic_match.group(1) + wrap(italic_match.group(2), 'em')\\",
      "            + italic_match.group(3)",
      "    else:",
