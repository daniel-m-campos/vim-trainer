      "def from_digits(digits, base):",
      "    return sum(number * base ** idx for idx, number in enumerate(reversed(digits)))",
      "",
      "",
      "def to_digits(number, base_to):",
      "    result = []",
      "    while number > 0:",
      "        result.append(number % base_to)",
