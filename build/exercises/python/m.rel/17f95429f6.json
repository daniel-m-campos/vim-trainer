      "import json",
      "",
      "",
      "class RestAPI:",
      "    def __init__(self, database=None):",
      "        self.database = database or {'users': []}",
      "",
      "    def update(self):",
      "        for user in self.database['users']:",
      "            owed_by = user['owed_by']",
      "            owes = user['owes']",
      "            for debtor in list(owed_by.keys()):",
      "                if debtor in owes:",
      "                    diff = 0",
      "                    if debtor in owes:",
      "                        diff = owes[debtor]",
      "                        del owes[debtor]",
      "                    if debtor in owed_by:",
      "                        diff -= owed_by[debtor]",
      "                        del owed_by[debtor]",
      "                    if diff > 0:",
      "                        owes[debtor] = diff",
      "                    elif diff < 0:",
      "                        owed_by[debtor] = -diff",
      "            user['balance'] = sum(owed_by.values()) - sum(owes.values())"
