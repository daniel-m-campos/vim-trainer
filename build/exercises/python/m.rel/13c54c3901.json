    "lines": [
      "def format_lines(matched_lines, flags, files):",
      "    result = []",
      "",
      "    for file_name, line_number, line in matched_lines:",
      "        line_result = ''",
      "",
      "        if len(files) > 1:",
      "            line_result += file_name + ':'",
      "",
      "        if '-n' in flags:",
      "            line_result += str(line_number) + ':'",
      "",
      "        line_result += line",
      "",
      "        result.append(line_result)",
      "",
      "    return ''.join(result)"
