  "task": "Move the cursor to the highlighted line `while gamma <= end:`",
  "start": {
    "lines": [
      "from math import sqrt, ceil, gcd",
      "",
      "",
      "def triplets_in_range(start, end):",
      "    for limit in range(4, end + 1, 4):",
      "        for x_pos, y_pos, z_pos in primitive_triplets(limit):",
      "            alpha = x_pos",
      "            beta = y_pos",
      "            gamma = z_pos",
      "",
      "            while alpha < start:",
      "                alpha = alpha + x_pos",
      "                beta = beta + y_pos",
      "                gamma = gamma + z_pos",
      "",
      "            while gamma <= end:",
      "                yield [alpha, beta, gamma]",
      "",
      "                alpha = alpha + x_pos",
      "                beta = beta + y_pos",
      "                gamma = gamma + z_pos"
    ],
