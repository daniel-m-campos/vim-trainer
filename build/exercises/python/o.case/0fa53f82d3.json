      "    words.reverse()",
      "",
      "try:",
      "    main_value = int(words.pop())",
      "except ValueError as error:",
      "    raise ValueError('syntax error') from error",
      "",
      "while words:",
      "    operation = [words.pop()]",
      "    while words:",
      "        try:",
      "            next_to_evaluate = words.pop()",
      "            second_value = int(next_to_evaluate)",
      "            break",
      "        except ValueError as error:",
