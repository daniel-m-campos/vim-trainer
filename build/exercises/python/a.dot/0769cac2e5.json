      "import random",
      "",
      "ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'",
      "class Robot:",
      "    def __init__(self):",
      "        self._name = None",
      "        self._past_names = set()",
      "",
      "    def prefix(self):",
      "        return ''.join([",
      "            random.choice(ALPHABET)",
      "            for _ in range(0, 2)",
      "        ])",
      "",
      "    def suffix(self):",
      "        return ''.join([",
      "            str(random.choice(range(0, 10)))",
      "            for _ in range(0, 3)",
      "        ])",
      "",
      "    def get_name(self):",
      "        if not self._name:",
      "",
      "            # Collision detection",
      "            while True:",
      "                self._name = self.prefix() + self.suffix()",
      "                if self._name not in self._past_names:",
      "                    self._past_names.add(self._name)",
      "                    break",
      "",
      "        return self._name",
      "",
      "    def del_name(self):",
      "        self._name = None",
      "",
      "    name = property(get_name, None, del_name)",
      "",
      "    def reset(self):",
      "        del self.name"
    ],
