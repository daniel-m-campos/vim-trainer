      "        else:",
      "            raise ValueError('syntax error')",
      "",
      "    operation = ' '.join(operation)",
      "",
      "    try:",
      "        main_value = VALID_OPERATIONS[operation](main_value, second_value)",
      "    except KeyError as error:",
      "        raise ValueError('syntax error') from error"
