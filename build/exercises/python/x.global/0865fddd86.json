      "    return letter.replace('die.', 'die.slice').split('slice')",
      "",
      "",
      "def recite(start_verse, end_verse):",
      "    generated = [verse.strip().split('\\n') for verse in verses(get_song())]",
      "    if start_verse == end_verse:",
      "        return generated[start_verse - 1]",
      "    else:",
      "        result = []",
