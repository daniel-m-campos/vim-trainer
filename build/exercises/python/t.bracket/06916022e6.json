      "EIGHT_BIT_MASK = 0x80",
      "SEVEN_BIT_MASK = 0x7f",
      "",
      "",
      "def encode_single(number):",
      "    byte_string = [number & SEVEN_BIT_MASK]",
      "    number >>= 7",
      "",
