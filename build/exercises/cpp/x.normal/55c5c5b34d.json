  "task": "Comment out these 3 lines: put `// ` at the start of each",
  "start": {
    "lines": [
      "std::string decode(const std::string& text, int a, int b) {",
      "    const int m = 26;",
      "    if (gcd(a, m) != 1) throw std::invalid_argument(\"a and m must be coprime.\");",
      "    int inv = modinv(a, m);",
      "    std::string out;",
      "    out.reserve(text.size());",
      "    for (char ch : text) {",
      "        if (std::isalpha(ch)) {",
      "            int y = std::tolower(ch) - 'a';",
      "            out += char('a' + mod(inv * (y - b), m));",
      "        } else if (std::isdigit(ch)) {",
      "            out += ch;",
      "        }",
      "    }",
      "    return out;",
      "}"
    ],
    "cursor": [
      4,
