      "clock::clock(int hour, int minute) : hour_(hour), minute_(minute) { clean(); }",
      "",
      "void clock::clean() {",
      "    if (minute_ < 0) {",
      "        int tmp = 1 + (minute_ / -minutes_per_hour);",
      "        hour_ -= tmp;",
      "        minute_ += minutes_per_hour * tmp;",
      "    }",
      "    if (hour_ < 0) hour_ += hours_per_day * (1 + (hour_ / -hours_per_day));",
      "    hour_ += minute_ / minutes_per_hour;",
      "    hour_ %= hours_per_day;",
      "    minute_ %= minutes_per_hour;",
      "}",
      "",
      "clock clock::at(int hour, int minute /*= 0*/) { return clock(hour, minute); }",
      "",
      "bool clock::operator==(const clock& rhs) const {",
      "    return hour_ == rhs.hour_ && minute_ == rhs.minute_;",
      "}"
