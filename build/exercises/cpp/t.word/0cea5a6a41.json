      "",
      "#include \"isbn_verifier.h\"",
      "",
      "namespace isbn_verifier {",
      "bool is_valid(const std::string& isbn) {",
      "    auto raw_string = std::regex_replace(isbn, std::regex(\"-\"), \"\");",
