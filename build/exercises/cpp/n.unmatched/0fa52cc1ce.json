      "void List::reverse() {",
      "    Element* new_head = nullptr;",
      "    while (head != nullptr) {",
      "        auto temp = new_head;",
      "        new_head = head;",
      "        head = head->next;",
      "        new_head->next = temp;",
      "    }",
