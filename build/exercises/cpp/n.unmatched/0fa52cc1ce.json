      "int List::pop() {",
      "    if (head == nullptr) {",
      "        throw std::runtime_error(\"Cannot pop from empty list.\");",
      "    } else {",
      "        auto element = head;",
      "        head = head->next;",
      "        int data = element->data;",
      "        delete element;",
      "        current_size--;",
      "        return data;",
      "    }",
      "}",
