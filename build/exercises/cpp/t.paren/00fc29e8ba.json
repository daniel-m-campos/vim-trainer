      "    std::vector<std::string> annotation{};",
      "    for (size_t row{}; row < minefield.size(); ++row) {",
      "        std::string annotaded_line{};",
      "        for (size_t column{}; column < minefield.at(0).size(); ++column) {",
      "            if (minefield.at(row).at(column) == '*') {",
      "                annotaded_line += '*';",
      "            } else {",
