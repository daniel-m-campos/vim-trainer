      "                char score_char =",
      "                    (score_number == 0) ? ' ' : char(score_number) + '0';",
      "                annotaded_line += score_char;",
      "            }",
      "        }",
      "        annotation.emplace_back(annotaded_line);",
      "    }",
      "    return annotation;",
      "}"
