  "task": "Change the contents of this subscript `[maximum_weight]` to `index`",
  "start": {
    "lines": [
      "#include \"knapsack.h\"",
      "",
      "namespace knapsack {",
      "",
      "int maximum_value(int maximum_weight, const std::vector<Item>& items) {",
      "    std::vector<int> dp(maximum_weight + 1);",
      "    for (auto item : items)",
      "        for (int weight = maximum_weight; weight >= item.weight; --weight)",
      "            dp[weight] =",
      "                std::max(dp[weight], dp[weight - item.weight] + item.value);",
      "    return dp[maximum_weight];",
      "}",
      "",
      "}  // namespace knapsack"
    ],
